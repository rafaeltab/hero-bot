{
  "name": "hero-bot",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": "24.22.2",
    "pnpm": "12.16.1"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "make --no-print-directory dev",
    "start": "pnpm --filter @hero-bot/discord-bot start",
    "lint": "biome check . && pnpm lint:tests",
    "format": "biome check --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "coverage": "node scripts/run-coverage.mjs",
    "check": "pnpm lint && pnpm architecture && pnpm typecheck && pnpm test && pnpm test:crap && pnpm coverage",
    "test:crap": "node --test scripts/test/*.test.mjs",
    "crap": "node scripts/check-crap.mjs",
    "architecture": "depcruise --config .dependency-cruiser.cjs --output-type err apps/discord-bot/src && node scripts/check-architecture-fixtures.mjs",
    "lint:tests": "eslint \"apps/*/test/**/*.ts\" --max-warnings 0 && node --test scripts/test-lint/check.test.mjs",
    "mutation": "node scripts/mutation/run.mjs",
    "mutation:verify": "node --test scripts/mutation/*.test.mjs",
    "postinstall": "node scripts/worktree/postinstall.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@vitest/eslint-plugin": "1.6.28",
    "dependency-cruiser": "18.7.2",
    "eslint": "10.14.0",
    "turbo": "2.11.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
