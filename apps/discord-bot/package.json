{
  "name": "@hero-bot/discord-bot",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "node --env-file-if-exists=.env --experimental-strip-types src/main.ts",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "effect": "4.1.2",
    "@effect/platform-node": "4.1.2",
    "dfx": "1.1.1"
  },
  "devDependencies": {
    "@effect/vitest": "4.1.2",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.1.0",
    "vitest": "5.1.0"
  }
}
