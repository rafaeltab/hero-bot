# Copy to ignored .env. Fill these from a SEPARATE development Discord application
# and a dedicated test server. Never use production credentials or commit secrets.
HERO_ENV=development
DEV_DISCORD_BOT_TOKEN=
DEV_DISCORD_APPLICATION_ID=
DEV_DISCORD_GUILD_ID=

# AI configuration; moderation message creation invokes paid judgments.
# Supply independently for development/production. Never commit an actual API key.
# HERO_AI_API_KEY=
# HERO_AI_MODEL=gpt-6-luna

# Opt-in notification-only runtime; separate from DEV_DISCORD_GUILD_ID smoke.
# DEV_MODERATION_GUILD_IDS=123456789012345678,234567890123456789
# PROD_DISCORD_BOT_TOKEN=
# PROD_DISCORD_APPLICATION_ID=
# PROD_MODERATION_GUILD_IDS=
