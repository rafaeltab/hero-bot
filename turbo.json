{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": [
        "HERO_ENV",
        "DEV_DISCORD_BOT_TOKEN",
        "DEV_DISCORD_APPLICATION_ID",
        "DEV_DISCORD_GUILD_ID",
        "HERO_AI_API_KEY",
        "HERO_AI_MODEL"
      ]
    },
    "typecheck": {},
    "test": {
      "env": ["HERO_TEST_DATABASE_URL"],
      "dependsOn": ["build"]
    },
    "coverage": {
      "env": ["HERO_TEST_DATABASE_URL"],
      "dependsOn": ["build"],
      "cache": false,
      "outputs": ["coverage/**"]
    }
  },
  "globalPassThroughEnv": ["GITHUB_STEP_SUMMARY", "TMPDIR"]
}
