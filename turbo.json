{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": [
        "HERO_ENV",
        "DEV_DISCORD_BOT_TOKEN",
        "DEV_DISCORD_APPLICATION_ID",
        "DEV_DISCORD_GUILD_ID"
      ]
    },
    "typecheck": {},
    "test": {
      "dependsOn": ["build"]
    },
    "coverage": {
      "dependsOn": ["build"],
      "cache": false,
      "outputs": ["coverage/**"]
    }
  }
}
