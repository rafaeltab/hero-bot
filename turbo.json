{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": ["HERO_ENV", "HERO_AI_API_KEY", "HERO_AI_MODEL"]
    },
    "typecheck": {},
    "test": {
      "env": ["HERO_TEST_DATABASE_URL"],
      "dependsOn": ["build"]
    },
    "coverage": {
      "env": ["HERO_TEST_DATABASE_URL"],
      "dependsOn": ["build"],
      "cache": false,
      "outputs": ["coverage/**"]
    }
  }
}
